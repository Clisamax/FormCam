{
  "name": "formcam",
  "main": "expo-router/entry",
  "slug": "formcam",
  "scheme": "formcam",
  "runtimeVersion": {
    "policy": "appVersion"
  },
  "license": "MIT",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:tunnel": "expo start --dev-client --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eas:build:ios": "eas build --profile development --platform ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "ios:build": "rm -rf ios/Pods ios/Podfile.lock && cd ios && pod install"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@aws-amplify/auth": "^6.17.1",
