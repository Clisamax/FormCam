  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.clisamax.FormCam",
    "runtimeVersion": "1.0.0",
    "infoPlist": {
      "NSCameraUsageDescription": "Este aplicativo precisa acessar a câmera para tirar fotos."
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": []
      }
    },
    "ios": {
      "simulatorDevice": "iPhone 15"
    }
