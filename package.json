    "@types/react-native-vector-icons": "^6.4.18",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.8.1",
    "buffer": "^6.0.3",
    "dotenv": "^16.5.0",
    "expo": "^54.0.33",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-linking": "~8.0.11",
    "expo-media-library": "~18.2.1",
    "expo-router": "^6.0.23",
    "expo-splash-screen": "~31.0.13",
